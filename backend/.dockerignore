# não entram na imagem.

.git
.gitignore
.dockerignore
Dockerfile
node_modules
dist
build
coverage
.temp
.tmp
.env*
**/.env*
**/secrets
**/*.pem
**/*.key
**/*.p12
**/*.dump
**/*.sqlite*
*.log
logs
*.tsbuildinfo
**/*.spec.ts
SNAPSHOT_MANIFEST.sha256
