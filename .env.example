# URL pública da API NestJS acessível pelo dispositivo.
# Não é a porta do Expo/Metro (8083).
#
# Emulador Android padrão: http://10.0.2.2:3101
# Aparelho Android por USB: http://127.0.0.1:3101 (com adb reverse tcp:3101 tcp:3101)
# Celular na mesma Wi-Fi: exige publicar a API na rede local (não é o padrão da demo).
#
# Esta variável é pública no bundle do app: nunca coloque segredos aqui.
EXPO_PUBLIC_API_URL=http://10.0.2.2:3101
