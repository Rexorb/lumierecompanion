# Lumière Companion — exemplo de configuração da demo (NÃO contém segredos reais).
#
# Forma recomendada (gera segredos e cria .env.demo com permissão 600):
#   ./scripts/setup-demo.sh
#
# Alternativa manual:
#   cp .env.demo.example .env.demo
#   openssl rand -hex 24     # POSTGRES_PASSWORD (URL-safe)
#   openssl rand -hex 48     # JWT_SECRET (>= 32 bytes)
#
# O arquivo .env.demo é ignorado pelo Git. Nunca reutilize os valores abaixo.

# Porta publicada apenas em 127.0.0.1 no host.
DEMO_API_PORT=3101

# PostgreSQL 16 isolado (sem porta publicada no host).
POSTGRES_USER=lumiere_demo
POSTGRES_PASSWORD=EXEMPLO_TROQUE_POR_SENHA_HEX_ALEATORIA
POSTGRES_DB=lumiere_demo

# Usuários fictícios do seed. As senhas são geradas localmente pelo
# scripts/setup-demo.sh e nunca devem ser fixadas no repositório.
DEMO_USER_A_NAME="Demonstração Alfa"
DEMO_USER_A_EMAIL=demo.alfa@lumiere.test
DEMO_PASSWORD_A=EXEMPLO_TROQUE_POR_SENHA_GERADA_LOCALMENTE
DEMO_USER_B_NAME="Demonstração Beta"
DEMO_USER_B_EMAIL=demo.beta@lumiere.test
DEMO_PASSWORD_B=EXEMPLO_TROQUE_POR_SENHA_GERADA_LOCALMENTE

# Obrigatório: >= 32 bytes, sem espaços nas extremidades, ao menos 8 caracteres distintos.
JWT_SECRET=EXEMPLO_TROQUE_POR_SEGREDO_ALEATORIO_DE_48_BYTES
# Opcional, apenas em segundos (o backend atual usa parseInt; "1d" viraria 1s).
# JWT_EXPIRES_IN=604800

# Opcional: sem chave o boot funciona e a recuperação de senha não envia e-mail.
RESEND_API_KEY=
MAIL_FROM=noreply@lumiere.local
APP_URL=http://localhost:8083
